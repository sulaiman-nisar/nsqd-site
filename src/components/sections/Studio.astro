---
import { site } from "~/lib/site";
---

<section id="studio" class="section" aria-labelledby="studio-heading">
  <div class="wrap grid lg:grid-cols-[1fr_1fr] gap-12">
    <div>
      <p class="eyebrow">The Studio</p>
      <h2 id="studio-heading" class="mt-3 text-h1 font-extrabold tracking-tightest">
        Two cities. <span class="hl">One team.</span>
      </h2>
      <p class="mt-5 text-paper/85 leading-relaxed max-w-xl">
        NSQD operates from a fabrication warehouse in Jebel Ali, Dubai, and a studio
        in Wynberg, Cape Town. The same people on the same brief — design from one
        side, production from the other, install wherever it lands.
      </p>
      <p class="mt-4 text-paper/85 leading-relaxed max-w-xl">
        Lean team. No subcontractor chain hiding behind a brand. The person you
        message is the person on the floor.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      {site.offices.map((office) => (
        <article class="border border-edge bg-ink/40 p-6">
          <div class="eyebrow">{office.country}</div>
          <h3 class="mt-3 text-h3 font-bold tracking-tightest">{office.city}</h3>
          <p class="mt-1 font-spec text-mute text-sm">{office.area}</p>
          <p class="mt-4 text-paper/85 text-sm leading-relaxed">{office.address}</p>
        </article>
      ))}
    </div>
  </div>
</section>
