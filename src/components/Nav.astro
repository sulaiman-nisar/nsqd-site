---
// Absolute hrefs so the nav resolves from sub-pages (e.g. /work/apc-scale-model).
// On the homepage the Lenis interceptor in BaseLayout treats these as in-page
// smooth scrolls; on sub-pages the browser navigates to the homepage anchor.
const navItems = [
  { label: "Work", href: "/#work" },
  { label: "The Floor", href: "/#floor" },
  { label: "Capabilities", href: "/#capabilities" },
  { label: "Studio", href: "/#studio" },
  { label: "Contact", href: "/#contact" },
];
---

<header class="fixed top-0 inset-x-0 z-30 backdrop-blur-md bg-ink/70 border-b border-edge">
  <div class="wrap flex items-center justify-between py-4 px-gutter">
    <a href="/" class="flex items-center gap-3 text-paper" aria-label="NSQD home">
      <img
        src="/images/logo/nsqd-logo.svg"
        alt="NSQD"
        width="96"
        height="25"
        class="h-[25px] w-auto block select-none"
        draggable="false"
      />
      <span class="hidden sm:inline text-eyebrow font-spec uppercase text-sun pl-3 border-l border-edge">Necessity Squared</span>
    </a>

    <nav class="hidden md:flex items-center gap-7 font-spec text-sm">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-paper/85 hover:text-paper transition-colors duration-150"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <button
      type="button"
      id="nav-menu-button"
      class="md:hidden text-paper/85 font-spec text-sm tag"
      aria-expanded="false"
      aria-controls="nav-menu-overlay"
    >
      Menu
    </button>
  </div>
</header>

<!-- Mobile menu: full-screen ink overlay, big type, saffron indices. -->
<div
  id="nav-menu-overlay"
  class="fixed inset-0 z-[45] bg-ink hidden flex-col md:!hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
>
  <div class="flex items-center justify-between py-4 px-gutter border-b border-edge">
    <a href="/" class="flex items-center text-paper" aria-label="NSQD home">
      <img
        src="/images/logo/nsqd-logo.svg"
        alt="NSQD"
        width="96"
        height="25"
        class="h-[25px] w-auto block select-none"
        draggable="false"
      />
    </a>
    <button
      type="button"
      id="nav-menu-close"
      class="text-paper/85 font-spec text-sm tag"
    >
      Close
    </button>
  </div>

  <nav class="flex-1 flex flex-col justify-center px-gutter" aria-label="Mobile">
    <ul class="space-y-1">
      {navItems.map((item, i) => (
        <li>
          <a
            href={item.href}
            class="nav-menu-link group flex items-baseline gap-4 py-3 motion-safe:translate-y-2 motion-safe:opacity-0"
            style={`--menu-i:${i}`}
          >
            <span class="font-mono text-sm text-sun" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <span class="font-sans font-extrabold uppercase tracking-tightest text-4xl text-paper group-active:text-sun transition-colors">
              {item.label}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="px-gutter pb-10 flex items-center justify-between border-t border-edge pt-6">
    <span class="eyebrow">Dubai · Cape Town</span>
    <span class="font-spec text-sm text-mute">Built to spec.</span>
  </div>
</div>

<style>
  /* Open state: overlay becomes a flex column; links stagger up. */
  #nav-menu-overlay.is-open {
    display: flex;
  }
  @media (prefers-reduced-motion: no-preference) {
    #nav-menu-overlay.is-open .nav-menu-link {
      animation: nav-link-in 0.35s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
      animation-delay: calc(var(--menu-i) * 55ms + 60ms);
    }
    @keyframes nav-link-in {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #nav-menu-overlay .nav-menu-link {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  // Delegated to document so the handlers survive ClientRouter page swaps
  // (this module runs once; the elements are re-rendered on each navigation).
  function setOpen(open: boolean) {
    const button = document.getElementById("nav-menu-button");
    const overlay = document.getElementById("nav-menu-overlay");
    if (!button || !overlay) return;
    overlay.classList.toggle("is-open", open);
    overlay.classList.toggle("hidden", !open);
    button.setAttribute("aria-expanded", String(open));
    document.documentElement.classList.toggle("overflow-hidden", open);
    // Let the Lenis instance in BaseLayout pause/resume wheel + touch scroll.
    window.dispatchEvent(new CustomEvent(open ? "nsqd:menu-open" : "nsqd:menu-close"));
    if (open) {
      overlay.querySelector<HTMLAnchorElement>(".nav-menu-link")?.focus();
    } else {
      button.focus();
    }
  }

  document.addEventListener("click", (e) => {
    const target = e.target as Element | null;
    if (!target) return;
    if (target.closest("#nav-menu-button")) setOpen(true);
    else if (target.closest("#nav-menu-close")) setOpen(false);
    // Navigating (same-page smooth scroll or cross-page) dismisses the menu.
    else if (target.closest("#nav-menu-overlay a")) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && document.getElementById("nav-menu-overlay")?.classList.contains("is-open")) {
      setOpen(false);
    }
  });
  // A view transition swaps in a fresh, closed overlay — clear the scroll lock.
  document.addEventListener("astro:after-swap", () => {
    document.documentElement.classList.remove("overflow-hidden");
    window.dispatchEvent(new CustomEvent("nsqd:menu-close"));
  });
</script>
