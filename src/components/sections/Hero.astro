---
import WhatsAppButton from "~/components/WhatsAppButton.astro";
import { prefills } from "~/lib/whatsapp";
---

<section
  id="hero"
  class="relative overflow-hidden border-b border-edge"
  aria-labelledby="hero-heading"
>
  <div class="wrap px-gutter pt-12 pb-section grid lg:grid-cols-[1fr_1.2fr] gap-12 items-center min-h-[78vh]">
    <div>
      <p class="eyebrow">Dubai · Cape Town</p>

      <h1
        id="hero-heading"
        class="mt-5 font-sans font-extrabold tracking-tightest text-paper leading-[0.95] text-[clamp(2.5rem,6vw,5rem)]"
      >
        Bespoke fabrication
        <br />and brand activation.
        <br /><span class="hl">End-to-end, or by the part.</span>
      </h1>

      <p class="mt-7 max-w-xl text-paper/85 text-lg leading-relaxed">
        A warehouse in Dubai. A studio in Cape Town. One team that builds,
        prints, cuts and installs, for the brief or for the parts list.
      </p>

      <div class="mt-9 flex flex-wrap gap-3 items-center">
        <WhatsAppButton
          target="projects"
          message={prefills.general}
          label="WhatsApp us"
        />
        <a href="#work" class="btn-ghost">
          See the work
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
        </a>
      </div>
    </div>

    <!-- Hero centerpiece: APC scale model, blueprint-to-solid animation rendered in Blender from CAD geometry.
         The video element autoplays, muted, looping. prefers-reduced-motion swaps to a static poster of the
         final solid frame. Phase 2 will swap this for an interactive Three.js GLB.
         Container is aspect-[3/2], taller than 16:9 (gives the video visual weight against the big
         headline) but much wider than aspect-square. With object-cover, crops ~8% off each side of
         the source 16:9 video. Was aspect-video (full APC visible but felt small and floating);
         was previously aspect-square which cropped 22% off each side. -->
    <div class="relative aspect-[3/2] w-full">
      <video
        class="hero-video absolute inset-0 w-full h-full object-cover rounded-sm border border-edge"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        poster="/images/hero/apc-hero-poster.jpg"
        aria-label="APC scale model, blueprint materializing into the fabricated piece"
      >
        <source src="/videos/apc-hero.mp4" type="video/mp4" />
      </video>
      <img
        class="hero-video-fallback absolute inset-0 w-full h-full object-cover rounded-sm border border-edge"
        src="/images/hero/apc-hero-poster.jpg"
        alt="APC scale model fabricated by NSQD for the IDEX display case"
        loading="eager"
      />
      <!-- Corner registration marks: fabrication-shop visual cue, not decoration -->
      <svg class="absolute top-0 left-0 text-sun/60 z-10" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1"><path d="M0 6V0h6"/></svg>
      <svg class="absolute top-0 right-0 text-sun/60 z-10" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1"><path d="M16 0h6v6"/></svg>
      <svg class="absolute bottom-0 left-0 text-sun/60 z-10" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1"><path d="M0 16v6h6"/></svg>
      <svg class="absolute bottom-0 right-0 text-sun/60 z-10" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1"><path d="M22 16v6h-6"/></svg>
    </div>

    <style>
      /* Default: video plays, poster img hidden */
      .hero-video-fallback { display: none; }
      /* prefers-reduced-motion: hide video, show static poster */
      @media (prefers-reduced-motion: reduce) {
        .hero-video { display: none; }
        .hero-video-fallback { display: block; }
      }
    </style>
  </div>
</section>
