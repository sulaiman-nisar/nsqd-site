---
import ContactForm from "~/components/ContactForm.astro";
import WhatsAppButton from "~/components/WhatsAppButton.astro";
import { prefills } from "~/lib/whatsapp";
import { site } from "~/lib/site";
---

<section id="contact" class="section bg-ink" aria-labelledby="contact-heading">
  <div class="wrap">
    <p class="eyebrow">Start something</p>
    <h2 id="contact-heading" class="mt-3 text-h1 font-extrabold tracking-tightest max-w-3xl">
      Fastest way in: <span class="hl">WhatsApp.</span>
    </h2>

    <div class="mt-10 grid gap-3 max-w-xl">
      <WhatsAppButton
        target="projects"
        message={prefills.general}
        label="WhatsApp us about a project"
        class="w-full justify-center py-4"
      />
      <a
        href={`mailto:${site.emails.projects}`}
        class="btn-ghost w-full justify-center py-4 border-paper/40 hover:border-paper hover:bg-paper hover:text-ink"
      >
        Email us
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/></svg>
      </a>
    </div>

    <div class="mt-14 max-w-3xl">
      <p class="font-spec text-mute text-sm">or send a message below</p>
      <hr class="my-6" />
      <ContactForm />
    </div>
  </div>
</section>
