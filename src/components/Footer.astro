---
import { site } from "~/lib/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-edge mt-section">
  <div class="wrap section grid gap-12 lg:grid-cols-[1.2fr_1fr_1fr]">
    <div>
      <div class="text-2xl font-extrabold tracking-tightest">NSQD</div>
      <div class="eyebrow mt-1">Necessity Squared</div>
      <p class="mt-5 text-mute max-w-md leading-relaxed">
        Bespoke fabrication and brand activation. Two cities, one team.
      </p>
    </div>

    <div class="grid gap-6">
      <div>
        <div class="eyebrow text-paper/70">Jebel Ali</div>
        <p class="mt-2 text-paper/90">{site.offices[0].address}</p>
        <p class="mt-1">
          <a href={`mailto:${site.emails.projects}`} class="text-paper hover:text-sun transition-colors">{site.emails.projects}</a>
        </p>
        <p class="mt-1">
          <a href={`https://wa.me/${site.whatsapp.projects}`} target="_blank" rel="noopener" class="text-paper hover:text-sun transition-colors">+971 55 147 6222</a>
        </p>
      </div>
      <div>
        <div class="eyebrow text-paper/70">Cape Town</div>
        <p class="mt-2 text-paper/90">{site.offices[1].address}</p>
        <p class="mt-1">
          <a href={`mailto:${site.emails.quotes}`} class="text-paper hover:text-sun transition-colors">{site.emails.quotes}</a>
        </p>
        <p class="mt-1">
          <a href={`https://wa.me/${site.whatsapp.quotes}`} target="_blank" rel="noopener" class="text-paper hover:text-sun transition-colors">+971 50 275 3175</a>
        </p>
      </div>
    </div>

    <div>
      <div class="eyebrow text-paper/70">Capabilities</div>
      <ul class="mt-2 font-spec text-sm text-paper/85 leading-7">
        {site.capabilities.map((c) => <li>{c}</li>)}
      </ul>
      <div class="mt-6 flex items-center gap-4">
        <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-paper hover:text-sun transition-colors">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/></svg>
        </a>
        <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-paper hover:text-sun transition-colors">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.13 1 2.5 1 4.98 2.12 4.98 3.5zM.22 8.4h4.55V24H.22zM8.34 8.4h4.36v2.13h.06c.61-1.16 2.1-2.39 4.32-2.39 4.62 0 5.48 3.04 5.48 7v8.86h-4.55v-7.86c0-1.87-.03-4.28-2.61-4.28-2.61 0-3.01 2.04-3.01 4.15V24H8.34z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="wrap px-gutter pb-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-mute text-sm font-spec">
    <span>© {year} Necessity Squared. All work shown is original. No third-party IP.</span>
    <span class="text-paper/40">Built in Jebel Ali + Cape Town.</span>
  </div>
</footer>
