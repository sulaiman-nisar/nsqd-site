---
import { site } from "~/lib/site";

// Verbatim client testimonials (data lives in site.ts so the rendered HTML and
// the Review JSON-LD below stay in lockstep). Saffron left edge-rule echoes the
// <Pull> MDX component. Avatars are optional: when none is set we render an
// initials monogram rather than an empty circle.
const testimonials = site.testimonials;

const ORG_ID = `${site.url}/#organization`;

const monogram = (name: string) =>
  name
    .split(" ")
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0])
    .join("")
    .toUpperCase();

// Each testimonial becomes a schema.org Review pointing back at the
// Organization. No ratingValue — clients gave words, not scores — and these are
// deliberately kept out of the aggregateRating in SchemaOrg.astro.
const reviewSchema = {
  "@context": "https://schema.org",
  "@graph": testimonials.map((t) => ({
    "@type": "Review",
    reviewBody: t.quote,
    itemReviewed: { "@id": ORG_ID },
    author: {
      "@type": "Person",
      name: t.name,
      ...(t.role ? { jobTitle: t.role } : {}),
      ...(t.org ? { worksFor: { "@type": "Organization", name: t.org } } : {}),
    },
  })),
};
---

<section id="testimonials" class="section bg-ink border-t border-edge" aria-labelledby="testimonials-heading">
  <div class="wrap">
    <header class="mb-12 md:mb-16">
      <p class="eyebrow">Word of mouth</p>
      <h2 id="testimonials-heading" class="mt-3 text-h1 font-extrabold tracking-tightest max-w-3xl">
        The clients, <span class="hl">unedited</span>.
      </h2>
    </header>

    <div class="grid gap-10 md:gap-14">
      {testimonials.map((t) => (
        <figure class="border-l-2 border-sun pl-6 md:pl-8 max-w-4xl">
          <blockquote class="text-paper/90 leading-relaxed text-lg md:text-xl">
            {t.quote}
          </blockquote>
          <figcaption class="mt-6 flex items-center gap-4">
            {t.avatar ? (
              <img
                src={t.avatar}
                alt={t.name}
                width="48"
                height="48"
                loading="lazy"
                class="h-12 w-12 rounded-full object-cover ring-1 ring-sun/60"
              />
            ) : (
              <span
                aria-hidden="true"
                class="h-12 w-12 rounded-full grid place-items-center bg-sun/10 ring-1 ring-sun/40 font-spec font-semibold text-sun text-sm tracking-tightest"
              >
                {monogram(t.name)}
              </span>
            )}
            <span class="leading-tight">
              <span class="block font-sans font-semibold text-paper tracking-tightest">{t.name}</span>
              <span class="block font-spec text-sm text-mute">{t.role}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />
