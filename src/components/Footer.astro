---
import { site } from "~/lib/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-edge mt-section">
  <div class="wrap section grid gap-12 lg:grid-cols-[1.2fr_1fr_1fr]">
    <div>
      <img
        src="/images/logo/nsqd-logo.svg"
        alt="NSQD"
        width="96"
        height="25"
        class="h-[25px] w-auto block select-none"
        draggable="false"
      />
      <div class="eyebrow mt-3">Necessity Squared</div>
      <p class="mt-5 text-mute max-w-md leading-relaxed">
        Bespoke fabrication and brand activation. Two cities, one team.
      </p>
      <nav class="mt-6 flex flex-wrap gap-x-5 gap-y-2 font-spec text-sm">
        <a href="/saudi-arabia" class="text-paper/80 hover:text-sun transition-colors">Saudi Arabia</a>
        <a href="/south-africa" class="text-paper/80 hover:text-sun transition-colors">South Africa</a>
        <a href="/uk" class="text-paper/80 hover:text-sun transition-colors">UK &amp; EU</a>
      </nav>
    </div>

    <div class="grid gap-6">
      <div>
        <div class="eyebrow text-paper/70">Dubai</div>
        <p class="mt-2 text-paper/90">{site.offices[0].address}</p>
        <p class="mt-1">
          <a href={`mailto:${site.emails.projects}`} class="text-paper hover:text-sun transition-colors">{site.emails.projects}</a>
        </p>
        <p class="mt-1">
          <a href={`https://wa.me/${site.whatsapp.projects}`} target="_blank" rel="noopener" class="text-paper hover:text-sun transition-colors">+971 55 147 6222</a>
        </p>
      </div>
      <div>
        <div class="eyebrow text-paper/70">Cape Town</div>
        <p class="mt-2 text-paper/90">{site.offices[1].address}</p>
        <p class="mt-1">
          <a href={`mailto:${site.emails.quotes}`} class="text-paper hover:text-sun transition-colors">{site.emails.quotes}</a>
        </p>
        <p class="mt-1">
          <a href={`https://wa.me/${site.whatsapp.quotes}`} target="_blank" rel="noopener" class="text-paper hover:text-sun transition-colors">+971 50 275 3175</a>
        </p>
      </div>
    </div>

    <div>
      <div class="eyebrow text-paper/70">Capabilities</div>
      <ul class="mt-2 font-spec text-sm text-paper/85 leading-7">
        {site.capabilities.map((c) => <li>{c}</li>)}
      </ul>
      <div class="mt-6 flex items-center gap-4">
        <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="block text-paper hover:text-sun transition-colors leading-none">
          <!-- viewBox tightened from "0 0 24 24" to "2 2 20 20" so the content fills the box; otherwise the outline IG icon visually sits smaller than the filled LinkedIn glyph and reads lower in the row. -->
          <svg width="22" height="22" viewBox="2 2 20 20" fill="none" stroke="currentColor" stroke-width="1.8" class="block"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/></svg>
        </a>
        <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="block text-paper hover:text-sun transition-colors leading-none">
          <!-- viewBox shifted down by 1 unit so the LinkedIn glyph (which natively
               extends to y=24, the bottom edge) gets a unit of bottom padding,
               matching the Instagram icon's natural padding. Visual bottoms align. -->
          <svg width="22" height="22" viewBox="0 1 24 24" fill="currentColor" class="block"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.13 1 2.5 1 4.98 2.12 4.98 3.5zM.22 8.4h4.55V24H.22zM8.34 8.4h4.36v2.13h.06c.61-1.16 2.1-2.39 4.32-2.39 4.62 0 5.48 3.04 5.48 7v8.86h-4.55v-7.86c0-1.87-.03-4.28-2.61-4.28-2.61 0-3.01 2.04-3.01 4.15V24H8.34z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="wrap px-gutter pb-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-mute text-sm font-spec">
    <span>© {year} Necessity Squared. All work shown is original. No third-party IP.</span>
    <span class="text-paper/40">Built in Dubai + Cape Town.</span>
  </div>
</footer>
