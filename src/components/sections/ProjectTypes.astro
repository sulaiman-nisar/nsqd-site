---
import { Image } from "astro:assets";
import { resolveImage } from "~/lib/images";
import BorderGlow from "~/components/BorderGlow.astro";

const types = [
  {
    title: "Activations that move",
    desc: "Kinetic installations, interactive props, mechanical builds that get used.",
    tag: "Build",
    image: "/images/project-types/activations-that-move.jpg",
  },
  {
    title: "Brand objects at scale",
    desc: "Props, displays, signage systems. Big things, on time, on brand.",
    tag: "Build",
    image: "/images/project-types/brand-objects-at-scale.jpg",
  },
  {
    title: "Precision pieces",
    desc: "Trophies, awards, scale models. Tight tolerance, hand-finished.",
    tag: "Build",
    image: "/images/project-types/precision-pieces.jpg",
  },
  {
    title: "Print + apply",
    desc: "Vehicle wraps, environmental graphics, soft goods. Cut, print, install.",
    tag: "Build",
    image: "/images/project-types/print-and-apply.jpg",
  },
];
---

<section
  id="project-types"
  class="section"
  aria-labelledby="project-types-heading"
>
  <div class="wrap">
    <header class="mb-12">
      <p class="eyebrow">Build with us</p>
      <h2 id="project-types-heading" class="mt-3 text-h1 font-extrabold tracking-tightest max-w-3xl">
        Four kinds of project, <span class="hl">end-to-end.</span>
      </h2>
    </header>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
      {types.map((t) => (
        <BorderGlow class="group h-full transition-transform duration-300 ease-punch hover:-translate-y-0.5">
          <div class="relative aspect-[4/5] overflow-hidden bg-[radial-gradient(circle_at_30%_30%,rgba(255,255,255,0.05),transparent_60%)]">
            {resolveImage(t.image) && (
              <div class="absolute inset-x-0 -top-[8%] h-[116%] will-change-transform" data-parallax="4">
                <Image
                  src={resolveImage(t.image)!}
                  alt={t.title}
                  widths={[320, 480, 640]}
                  sizes="(min-width: 1024px) 300px, (min-width: 640px) 50vw, 100vw"
                  format="webp"
                  quality={78}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-700 ease-punch group-hover:scale-[1.04]"
                />
              </div>
            )}
            <div class="absolute top-3 left-3 tag bg-ink/70 backdrop-blur-sm">{t.tag}</div>
          </div>
          <div class="p-5">
            <h3 class="text-h3 font-bold tracking-tightest">{t.title}</h3>
            <p class="mt-2 text-paper/80 text-sm leading-relaxed">{t.desc}</p>
          </div>
        </BorderGlow>
      ))}
    </div>
  </div>
</section>
