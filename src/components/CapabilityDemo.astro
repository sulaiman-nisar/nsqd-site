---
// One small SVG demo per capability — referenced by the icon key in Capabilities.astro.
// All sized to viewBox 0 0 200 120 (matches the parent's aspect-[5/3]).
// CSS animations are gated behind prefers-reduced-motion: no-preference, so reduced-motion
// users see a recognizable static "final-state" frame.
//
// SMIL animateMotion is used for path-following bits (laser cuts) — same pattern as
// the existing TheFloor section, so behavior matches sitewide.

interface Props {
  icon: string;
  label?: string;
}

const { icon, label } = Astro.props;
---

<div class="cap-demo" aria-label={label ?? icon} role="img">
  {icon === "laser" && (
    <svg viewBox="0 0 200 120" preserveAspectRatio="xMidYMid meet" class="w-full h-full">
      <rect x="30" y="20" width="140" height="80" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.12)" stroke-width="1" />
      <path id="laser-cut" d="M 60 40 L 140 40 L 140 80 L 60 80 Z" fill="none" stroke="#FFB600" stroke-width="1.5" pathLength="100" class="laser-line" />
      <g class="laser-head">
        <line x1="0" y1="-14" x2="0" y2="0" stroke="#FF3B30" stroke-width="1.2" opacity="0.85" />
        <circle r="3" fill="#FFB600" />
        <circle r="6" fill="#FFB600" opacity="0.25" />
        <animateMotion dur="4s" repeatCount="indefinite" rotate="0">
          <mpath href="#laser-cut" />
        </animateMotion>
      </g>
    </svg>
  )}

  {icon === "fiber" && (
    <svg viewBox="0 0 200 120" preserveAspectRatio="xMidYMid meet" class="w-full h-full">
      <rect x="30" y="25" width="140" height="70" fill="rgba(200,210,225,0.05)" stroke="rgba(255,255,255,0.15)" stroke-width="1" />
      <g stroke="rgba(255,255,255,0.05)" stroke-width="1">
        <line x1="30" y1="38" x2="170" y2="38" />
        <line x1="30" y1="52" x2="170" y2="52" />
        <line x1="30" y1="66" x2="170" y2="66" />
        <line x1="30" y1="80" x2="170" y2="80" />
      </g>
      <path id="fiber-cut" d="M 55 75 Q 100 25, 145 75" fill="none" stroke="#FFB600" stroke-width="1.5" pathLength="100" class="fiber-line" />
      <g class="fiber-head">
        <circle r="2.5" fill="#FFFFFF" />
        <circle r="5" fill="#FFB600" opacity="0.55" />
        <circle r="9" fill="#FFB600" opacity="0.18" />
        <g class="fiber-sparks">
          <circle cx="-4" cy="-3" r="0.8" fill="#FFB600" />
          <circle cx="5" cy="-2" r="0.8" fill="#FFFFFF" />
          <circle cx="2" cy="5" r="0.8" fill="#FFB600" />
          <circle cx="-3" cy="4" r="0.6" fill="#FFFFFF" />
        </g>
        <animateMotion dur="3.6s" repeatCount="indefinite">
          <mpath href="#fiber-cut" />
        </animateMotion>
      </g>
    </svg>
  )}

  {icon === "uv" && (
    <svg viewBox="0 0 200 120" preserveAspectRatio="xMidYMid meet" class="w-full h-full">
      <rect x="25" y="30" width="150" height="60" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.12)" stroke-width="1" />
      <g class="uv-print">
        <rect x="25" y="38" width="150" height="10" fill="#FFB600" opacity="0.65" class="uv-stripe uv-stripe-1" />
        <rect x="25" y="55" width="150" height="10" fill="#FFFFFF" opacity="0.4" class="uv-stripe uv-stripe-2" />
        <rect x="25" y="72" width="150" height="10" fill="#FFB600" opacity="0.5" class="uv-stripe uv-stripe-3" />
      </g>
      <line x1="20" y1="24" x2="180" y2="24" stroke="rgba(255,255,255,0.28)" stroke-width="1.5" />
      <g class="uv-carriage">
        <rect x="-14" y="20" width="28" height="8" fill="#FFFFFF" opacity="0.9" />
        <rect x="-9" y="28" width="18" height="62" fill="rgba(255,255,255,0.16)" />
        <line x1="0" y1="28" x2="0" y2="88" stroke="#FFB600" stroke-width="0.8" opacity="0.8" />
      </g>
    </svg>
  )}

  {icon === "ecosol" && (
    <svg viewBox="0 0 200 120" preserveAspectRatio="xMidYMid meet" class="w-full h-full">
      <polygon
        points="66,48 134,48 134,93 128,100 72,100 66,93"
        fill="rgba(255,255,255,0.1)"
        stroke="#FFB600"
        stroke-width="1.3"
        stroke-linejoin="round"
      />
      <rect x="35" y="18" width="130" height="30" rx="2.5" fill="rgba(255,255,255,0.06)" stroke="rgba(255,255,255,0.18)" stroke-width="1" />
      <rect x="44" y="38" width="112" height="5" fill="#FFB600" />
      <g fill="rgba(255,255,255,0.06)" stroke="rgba(255,255,255,0.18)" stroke-width="1">
        <rect x="39" y="48" width="5" height="18" />
        <rect x="53" y="48" width="5" height="18" />
        <rect x="142" y="48" width="5" height="18" />
        <rect x="156" y="48" width="5" height="18" />
      </g>
      <line class="ecosol-scan" x1="68" y1="50" x2="132" y2="50" stroke="#FFB600" stroke-width="1.5" opacity="0" />
    </svg>
  )}

  {icon === "dtf" && (
    <svg viewBox="0 0 200 120" preserveAspectRatio="xMidYMid meet" class="w-full h-full">
      <rect x="35" y="78" width="130" height="20" fill="rgba(255,255,255,0.06)" stroke="rgba(255,255,255,0.18)" stroke-width="1" />
      <rect x="60" y="80" width="80" height="6" fill="#FFB600" opacity="0" class="dtf-transferred" />
      <g class="dtf-press">
        <rect x="35" y="22" width="130" height="18" fill="rgba(255,255,255,0.14)" stroke="rgba(255,255,255,0.3)" stroke-width="1" />
        <rect x="91" y="0" width="18" height="6" rx="1.5" fill="rgba(255,255,255,0.4)" stroke="rgba(255,255,255,0.55)" stroke-width="0.8" />
        <rect x="97" y="5" width="6" height="17" fill="rgba(255,255,255,0.38)" />
        <text x="100" y="34" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="7" letter-spacing="0.05em" fill="#FFB600" opacity="0.9">160°C</text>
        <rect x="60" y="40" width="80" height="6" fill="#FFB600" opacity="0.85" class="dtf-onpress" />
      </g>
      <g class="dtf-heat" aria-hidden="true">
        <path d="M 70 76 Q 73 68, 70 60" fill="none" stroke="#FFB600" stroke-width="1" opacity="0.5" />
        <path d="M 100 76 Q 103 68, 100 60" fill="none" stroke="#FFB600" stroke-width="1" opacity="0.5" />
        <path d="M 130 76 Q 133 68, 130 60" fill="none" stroke="#FFB600" stroke-width="1" opacity="0.5" />
      </g>
    </svg>
  )}

  {icon === "fdm" && (
    <svg viewBox="0 0 200 120" preserveAspectRatio="xMidYMid meet" class="w-full h-full">
      <line x1="30" y1="15" x2="30" y2="100" stroke="rgba(255,255,255,0.22)" stroke-width="1" />
      <line x1="170" y1="15" x2="170" y2="100" stroke="rgba(255,255,255,0.22)" stroke-width="1" />
      <line x1="30" y1="15" x2="170" y2="15" stroke="rgba(255,255,255,0.22)" stroke-width="1" />
      <rect x="40" y="98" width="120" height="4" fill="rgba(255,255,255,0.12)" />
      <g class="fdm-layers">
        <rect x="80" y="92" width="40" height="4" fill="#FFB600" opacity="0.85" class="fdm-layer fdm-1" />
        <rect x="78" y="86" width="44" height="4" fill="#FFB600" opacity="0.8" class="fdm-layer fdm-2" />
        <rect x="80" y="80" width="40" height="4" fill="#FFB600" opacity="0.75" class="fdm-layer fdm-3" />
        <rect x="82" y="74" width="36" height="4" fill="#FFB600" opacity="0.7" class="fdm-layer fdm-4" />
        <rect x="85" y="68" width="30" height="4" fill="#FFB600" opacity="0.65" class="fdm-layer fdm-5" />
      </g>
      <g class="fdm-nozzle">
        <rect x="-12" y="-14" width="24" height="9" fill="rgba(255,255,255,0.16)" stroke="rgba(255,255,255,0.3)" stroke-width="1" />
        <polygon points="-4,-5 4,-5 0,1" fill="#FFB600" />
      </g>
    </svg>
  )}

  {icon === "cad" && (
    <svg viewBox="0 0 200 120" preserveAspectRatio="xMidYMid meet" class="w-full h-full">
      <g stroke="rgba(255,255,255,0.05)" stroke-width="1">
        <line x1="20" y1="20" x2="180" y2="20" />
        <line x1="20" y1="60" x2="180" y2="60" />
        <line x1="20" y1="100" x2="180" y2="100" />
        <line x1="50" y1="10" x2="50" y2="110" />
        <line x1="100" y1="10" x2="100" y2="110" />
        <line x1="150" y1="10" x2="150" y2="110" />
      </g>
      <g fill="none" stroke="#FFB600" stroke-width="1.5">
        <path d="M 60 80 L 110 80" pathLength="100" class="cad-line cad-1" />
        <path d="M 110 80 L 140 60" pathLength="100" class="cad-line cad-2" />
        <path d="M 140 60 L 140 30" pathLength="100" class="cad-line cad-3" />
        <path d="M 140 30 L 110 50" pathLength="100" class="cad-line cad-4" />
        <path d="M 110 50 L 60 50" pathLength="100" class="cad-line cad-5" />
        <path d="M 60 50 L 60 80" pathLength="100" class="cad-line cad-6" />
        <path d="M 110 80 L 110 50" pathLength="100" class="cad-line cad-7" />
      </g>
    </svg>
  )}

  {icon === "asm" && (
    <svg viewBox="0 0 200 120" preserveAspectRatio="xMidYMid meet" class="w-full h-full">
      <line x1="20" y1="100" x2="180" y2="100" stroke="rgba(255,255,255,0.15)" stroke-width="1" stroke-dasharray="2 4" />
      <rect x="-40" y="50" width="60" height="20" rx="2" fill="rgba(255,255,255,0.1)" stroke="#FFB600" stroke-width="1.5" class="asm-left" />
      <rect x="180" y="50" width="60" height="20" rx="2" fill="rgba(255,255,255,0.1)" stroke="#FFB600" stroke-width="1.5" class="asm-right" />
      <g class="asm-bolt">
        <circle cx="100" cy="60" r="5" fill="none" stroke="#FFB600" stroke-width="1.5" />
        <g class="asm-bolt-rot">
          <line x1="100" y1="55" x2="100" y2="65" stroke="#FFFFFF" stroke-width="1" />
          <line x1="95" y1="60" x2="105" y2="60" stroke="#FFFFFF" stroke-width="1" />
        </g>
      </g>
    </svg>
  )}
</div>

<style>
  .cap-demo {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Static "final-state" defaults — what reduced-motion users see. */
  .laser-line { stroke-dasharray: 100; stroke-dashoffset: 0; }
  .fiber-line { stroke-dasharray: 100; stroke-dashoffset: 0; }
  .uv-stripe { transform: scaleX(1); transform-origin: left center; transform-box: fill-box; }
  .uv-carriage { transform: translateX(100px); }
  .ecosol-scan { opacity: 0; transform: translateY(0); }
  .dtf-press { transform: translateY(0); }
  .dtf-onpress { opacity: 0; }
  .dtf-transferred { opacity: 0.85; }
  .dtf-heat { opacity: 0; }
  .fdm-layer { opacity: 0.7; }
  .fdm-nozzle { transform: translate(100px, 60px); }
  .cad-line { stroke-dasharray: 100; stroke-dashoffset: 0; }
  .asm-left { transform: translateX(80px); }
  .asm-right { transform: translateX(-80px); }
  .asm-bolt-rot { transform-origin: 100px 60px; transform-box: view-box; }

  @media (prefers-reduced-motion: no-preference) {
    /* CO2 laser: cut path reveals as the head follows the rectangle */
    .laser-line { stroke-dashoffset: 100; animation: laser-cut-anim 4s linear infinite; }
    @keyframes laser-cut-anim {
      from { stroke-dashoffset: 100; }
      to { stroke-dashoffset: 0; }
    }

    /* Fiber laser: arc reveal + spark flicker */
    .fiber-line { stroke-dashoffset: 100; animation: fiber-cut-anim 3.6s linear infinite; }
    @keyframes fiber-cut-anim {
      from { stroke-dashoffset: 100; }
      to { stroke-dashoffset: 0; }
    }
    .fiber-sparks {
      transform-origin: center;
      transform-box: fill-box;
      animation: fiber-sparks-anim 0.28s linear infinite;
    }
    @keyframes fiber-sparks-anim {
      0% { opacity: 1; transform: scale(1); }
      100% { opacity: 0.3; transform: scale(1.5); }
    }

    /* UV flatbed: stripes print as the carriage scans across */
    .uv-stripe {
      transform: scaleX(0);
      animation: uv-stripe-anim 5s linear infinite;
    }
    .uv-stripe-2 { animation-delay: 0.08s; }
    .uv-stripe-3 { animation-delay: 0.16s; }
    @keyframes uv-stripe-anim {
      0% { transform: scaleX(0); }
      48%, 92% { transform: scaleX(1); }
      100% { transform: scaleX(0); }
    }
    .uv-carriage {
      transform: translateX(25px);
      animation: uv-carriage-anim 5s linear infinite;
    }
    @keyframes uv-carriage-anim {
      0% { transform: translateX(25px); }
      48% { transform: translateX(175px); }
      52% { transform: translateX(175px); }
      100% { transform: translateX(25px); }
    }

    /* ECO solvent: wide-format printer, scan line drops down the media as it prints */
    .ecosol-scan {
      animation: ecosol-scan-anim 2.8s linear infinite;
    }
    @keyframes ecosol-scan-anim {
      0%   { transform: translateY(0);  opacity: 0; }
      10%  { opacity: 0.9; }
      90%  { opacity: 0.9; }
      100% { transform: translateY(48px); opacity: 0; }
    }

    /* DTF: press descends with graphic on its underside, transfers to fabric, lifts empty */
    .dtf-press {
      animation: dtf-press-anim 4.4s ease-in-out infinite;
    }
    @keyframes dtf-press-anim {
      0%, 100% { transform: translateY(0); }
      30%, 65% { transform: translateY(38px); }
    }
    .dtf-onpress {
      animation: dtf-onpress-anim 4.4s ease-in-out infinite;
    }
    @keyframes dtf-onpress-anim {
      0%, 30% { opacity: 0.85; }
      45%, 90% { opacity: 0; }
      100% { opacity: 0.85; }
    }
    .dtf-transferred {
      animation: dtf-transferred-anim 4.4s ease-in-out infinite;
    }
    @keyframes dtf-transferred-anim {
      0%, 30% { opacity: 0; }
      45%, 92% { opacity: 0.85; }
      100% { opacity: 0; }
    }
    .dtf-heat {
      animation: dtf-heat-anim 4.4s ease-in-out infinite;
    }
    @keyframes dtf-heat-anim {
      0%, 28%, 70%, 100% { opacity: 0; transform: translateY(0); }
      40%, 60% { opacity: 1; transform: translateY(-4px); }
    }

    /* 3D printing: layers stack up as the nozzle climbs Z */
    .fdm-layer { opacity: 0; animation-duration: 5s; animation-iteration-count: infinite; animation-timing-function: linear; }
    .fdm-1 { animation-name: fdm-1; }
    .fdm-2 { animation-name: fdm-2; }
    .fdm-3 { animation-name: fdm-3; }
    .fdm-4 { animation-name: fdm-4; }
    .fdm-5 { animation-name: fdm-5; }
    @keyframes fdm-1 { 0%,9% { opacity: 0; } 10%,95% { opacity: 0.85; } 100% { opacity: 0; } }
    @keyframes fdm-2 { 0%,24% { opacity: 0; } 25%,95% { opacity: 0.8; } 100% { opacity: 0; } }
    @keyframes fdm-3 { 0%,39% { opacity: 0; } 40%,95% { opacity: 0.75; } 100% { opacity: 0; } }
    @keyframes fdm-4 { 0%,54% { opacity: 0; } 55%,95% { opacity: 0.7; } 100% { opacity: 0; } }
    @keyframes fdm-5 { 0%,69% { opacity: 0; } 70%,95% { opacity: 0.65; } 100% { opacity: 0; } }
    .fdm-nozzle {
      animation: fdm-nozzle-anim 5s linear infinite;
    }
    @keyframes fdm-nozzle-anim {
      0% { transform: translate(100px, 90px); }
      85% { transform: translate(100px, 65px); }
      95% { transform: translate(100px, 65px); }
      100% { transform: translate(100px, 90px); }
    }

    /* CAD/CAM: wireframe draws line-by-line */
    .cad-line { stroke-dashoffset: 100; animation-duration: 6s; animation-iteration-count: infinite; animation-timing-function: linear; }
    .cad-1 { animation-name: cad-1; }
    .cad-2 { animation-name: cad-2; }
    .cad-3 { animation-name: cad-3; }
    .cad-4 { animation-name: cad-4; }
    .cad-5 { animation-name: cad-5; }
    .cad-6 { animation-name: cad-6; }
    .cad-7 { animation-name: cad-7; }
    @keyframes cad-1 { 0% { stroke-dashoffset: 100; } 5%,95% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 100; } }
    @keyframes cad-2 { 0%,14% { stroke-dashoffset: 100; } 19%,95% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 100; } }
    @keyframes cad-3 { 0%,28% { stroke-dashoffset: 100; } 33%,95% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 100; } }
    @keyframes cad-4 { 0%,42% { stroke-dashoffset: 100; } 47%,95% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 100; } }
    @keyframes cad-5 { 0%,56% { stroke-dashoffset: 100; } 61%,95% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 100; } }
    @keyframes cad-6 { 0%,70% { stroke-dashoffset: 100; } 75%,95% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 100; } }
    @keyframes cad-7 { 0%,84% { stroke-dashoffset: 100; } 89%,95% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 100; } }

    /* Assembly: two pieces slide in, bolt fades up and turns */
    .asm-left { transform: translateX(0); animation: asm-l 4s ease-in-out infinite; }
    .asm-right { transform: translateX(0); animation: asm-r 4s ease-in-out infinite; }
    @keyframes asm-l {
      0% { transform: translateX(0); }
      40%, 90% { transform: translateX(80px); }
      100% { transform: translateX(0); }
    }
    @keyframes asm-r {
      0% { transform: translateX(0); }
      40%, 90% { transform: translateX(-80px); }
      100% { transform: translateX(0); }
    }
    .asm-bolt { opacity: 0; animation: asm-bolt-fade 4s ease-in-out infinite; }
    .asm-bolt-rot { transform: rotate(0deg); animation: asm-bolt-spin 4s ease-in-out infinite; }
    @keyframes asm-bolt-fade {
      0%, 42% { opacity: 0; }
      52%, 88% { opacity: 1; }
      95%, 100% { opacity: 0; }
    }
    @keyframes asm-bolt-spin {
      0%, 42% { transform: rotate(0deg); }
      52% { transform: rotate(0deg); }
      88% { transform: rotate(360deg); }
      100% { transform: rotate(360deg); }
    }
  }
</style>
