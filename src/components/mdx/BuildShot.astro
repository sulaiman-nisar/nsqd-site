---
import { Image } from "astro:assets";
import { resolveImage } from "~/lib/images";

interface Props {
  src: string;
  alt?: string;
  caption?: string;
  aspect?: "16/9" | "4/3" | "3/2" | "1/1" | "4/5" | "3/4" | "2/3" | "9/16";
}

const { src, alt = "", caption, aspect = "16/9" } = Astro.props;

const aspectClass = {
  "16/9": "aspect-[16/9]",
  "4/3": "aspect-[4/3]",
  "3/2": "aspect-[3/2]",
  "1/1": "aspect-square",
  "4/5": "aspect-[4/5]",
  "3/4": "aspect-[3/4]",
  "2/3": "aspect-[2/3]",
  "9/16": "aspect-[9/16]",
}[aspect];

const image = resolveImage(src);

// Case body column is 8/12 of the 78rem content width — ~832px max on desktop.
const SIZES = "(min-width: 1024px) 832px, 100vw";
---

{image && (
  <figure class="my-10">
    <div class:list={[
      "relative w-full border border-edge overflow-hidden bg-[radial-gradient(circle_at_35%_35%,rgba(255,255,255,0.04),transparent_60%)]",
      aspectClass,
    ]}>
      <Image
        src={image}
        alt={alt}
        widths={[480, 800, 1200]}
        sizes={SIZES}
        format="webp"
        quality={78}
        loading="lazy"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover"
      />
    </div>
    {caption && (
      <figcaption class="mt-3 font-spec text-mute text-sm">
        {caption}
      </figcaption>
    )}
  </figure>
)}
