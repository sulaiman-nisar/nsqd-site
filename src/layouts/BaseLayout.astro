---
// Self-hosted fonts (woff2, latin subset, font-display: swap). Only the
// weights the design actually uses — previously 11 weights came from a
// render-blocking Google Fonts request chain.
import "@fontsource/poppins/latin-400.css";
import "@fontsource/poppins/latin-500.css";
import "@fontsource/poppins/latin-600.css";
import "@fontsource/poppins/latin-700.css";
import "@fontsource/poppins/latin-800.css";
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "~/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import FloatingWhatsApp from "~/components/FloatingWhatsApp.astro";
import SchemaOrg from "~/components/SchemaOrg.astro";
import { site } from "~/lib/site";

interface Props {
  title?: string;
  description?: string;
  pathname?: string;
  ogImage?: string;
}

const {
  title = "NSQD | Bespoke fabrication and brand activation",
  description = "Bespoke fabrication and brand activation. End-to-end, or by the part. Dubai + Cape Town.",
  pathname,
  // Default OG image is the APC hero poster (real file, lives in /images/hero/).
  // Previous default referenced /og-default.jpg which didn't exist — link previews
  // on LinkedIn/Twitter/Slack were silently broken.
  ogImage = "/images/hero/apc-hero-poster.jpg",
} = Astro.props;

const canonical = new URL(pathname ?? Astro.url.pathname, site.url).toString();
const plausibleDomain = site.plausibleDomain;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0A0A0A" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.url).toString()} />
    <meta property="og:site_name" content="NSQD" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Plausible analytics: privacy-respecting, no cookies -->
    <script
      is:inline
      defer
      data-domain={plausibleDomain}
      src="https://plausible.io/js/script.tagged-events.outbound-links.js"
    ></script>

    <!-- Soft cross-page transitions (crossfade). Scripts below use event
         delegation + astro:page-load so they survive the DOM swap. -->
    <ClientRouter />

    <!-- JSON-LD structured data: Organization, WebSite, LocalBusiness x2.
         Page-specific schemas (CreativeWork on case studies) are emitted
         by the page itself, after this base. -->
    <SchemaOrg />
  </head>

  <body class="bg-ink text-paper antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-sun focus:text-ink focus:px-3 focus:py-2 focus:rounded"
    >
      Skip to content
    </a>

    <Nav />

    <main id="main" class="pt-20">
      <slot />
    </main>

    <Footer />

    <FloatingWhatsApp />

    <!-- Atmospheric film grain overlay. Fixed, pointer-events:none, mix-blend-mode:overlay.
         Sits above all content visually but never blocks interaction. SVG fractal noise
         inline as data URI, no extra HTTP request, ~1KB. Below 5% opacity so it adds
         texture without being noticed. Skipped under prefers-reduced-motion. -->
    <div class="grain-overlay" aria-hidden="true"></div>

    <!-- Lenis smooth scroll, respects prefers-reduced-motion.
         Duration 0.95s + exponential ease = premium inertia without lag.
         lerp 0.1 = finer interpolation between scroll positions.
         All handlers are delegated to document/window so they keep working
         after a ClientRouter page swap (this module only runs once). -->
    <script>
      import Lenis from "lenis";

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!reduced) {
        const lenis = new Lenis({
          duration: 0.95,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
          lerp: 0.1,
          touchMultiplier: 1.5,
        });
        const raf = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);

        // The mobile menu overlay locks the page; pause Lenis so wheel/touch
        // momentum doesn't scroll the document underneath it.
        window.addEventListener("nsqd:menu-open", () => lenis.stop());
        window.addEventListener("nsqd:menu-close", () => lenis.start());

        // Lenis-driven smooth scroll for same-page anchors. Handles both
        // bare "#anchor" and absolute "/#anchor" — the latter is what the
        // nav uses so links resolve from sub-pages, but we still want
        // smooth scroll when the user clicks them on the homepage.
        document.addEventListener("click", (e) => {
          const a = (e.target as Element | null)?.closest?.("a[href]");
          if (!a || e.defaultPrevented) return;
          const href = a.getAttribute("href");
          if (!href) return;
          let url: URL;
          try {
            url = new URL(href, location.origin);
          } catch {
            return;
          }
          const samePath = url.pathname === location.pathname;
          const hasHash = url.hash && url.hash !== "#";
          if (!samePath || !hasHash) return;
          const el = document.querySelector(url.hash);
          if (!el) return;
          e.preventDefault();
          lenis.scrollTo(el as HTMLElement, { offset: -64 });
        });
      }

      // Scroll reveals. Section headers fade up; grid tiles stagger in.
      // Classes are added here (not in markup) so no-JS visitors and
      // reduced-motion users always get fully visible content. The hero is
      // deliberately excluded — first paint stays instant. Re-runs on every
      // ClientRouter navigation via astro:page-load.
      const TILE_GROUPS = [
        "#work .grid > a",
        "#project-types .grid > article",
        "#capabilities .grid > *",
        "#clients ul > li",
        "#testimonials figure",
        "#faq dl > div",
      ];

      function initReveals() {
        if (reduced || !("IntersectionObserver" in window)) return;
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("rv-in");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
        );

        const headers = document.querySelectorAll("main section:not(#hero) > .wrap > header, main section:not(#hero) > header");
        headers.forEach((el) => {
          if (el.classList.contains("rv")) return;
          el.classList.add("rv");
          io.observe(el);
        });

        for (const selector of TILE_GROUPS) {
          document.querySelectorAll(selector).forEach((el, i) => {
            if (el.classList.contains("rv")) return;
            el.classList.add("rv");
            (el as HTMLElement).style.setProperty("--rv-d", `${Math.min(i * 55, 330)}ms`);
            io.observe(el);
          });
        }
      }

      // astro:page-load fires on first load and after every view transition.
      document.addEventListener("astro:page-load", initReveals);
    </script>
  </body>
</html>
