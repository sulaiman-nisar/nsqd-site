---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import WhatsAppButton from "~/components/WhatsAppButton.astro";
import { prefills } from "~/lib/whatsapp";
import { publicFileExists } from "~/lib/fileExists";

import Stat from "~/components/mdx/Stat.astro";
import Pull from "~/components/mdx/Pull.astro";
import BuildShot from "~/components/mdx/BuildShot.astro";
import BuildPair from "~/components/mdx/BuildPair.astro";

export async function getStaticPaths() {
  const entries = await getCollection("work", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;

type SpecRow = { label: string; value: string | string[] };
const specRows: SpecRow[] = [];
if (d.sectors.length > 0) specRows.push({ label: "Sector", value: d.sectors });
if (d.year) specRows.push({ label: "Year", value: String(d.year) });
if (d.capabilities.length > 0) specRows.push({ label: "Capabilities", value: d.capabilities });
if (d.materials && d.materials.length > 0) specRows.push({ label: "Materials", value: d.materials });
if (d.quantity) specRows.push({ label: "Quantity", value: d.quantity });
if (d.leadTime) specRows.push({ label: "Lead time", value: d.leadTime });
if (d.deliveredAt) specRows.push({ label: "Delivered", value: d.deliveredAt });

// Filter gallery to images that actually exist on disk — no empty boxes for
// shots that haven't been uploaded yet.
const galleryFiltered = (d.gallery ?? []).filter(publicFileExists);

const mdxComponents = { Stat, Pull, BuildShot, BuildPair };
---

<BaseLayout
  title={`${d.client} — ${d.title} | NSQD`}
  description={d.outcome}
  pathname={`/work/${entry.slug}`}
>
  <article class="wrap px-gutter pt-12">
    <a href="/#work" class="font-spec text-mute text-sm hover:text-paper transition-colors">← Back to work</a>

    <header class="mt-6 max-w-4xl">
      <div class="flex flex-wrap items-center gap-3">
        <span class="tag">{d.type}</span>
        {d.year && <span class="font-spec text-mute text-sm">{d.year}</span>}
      </div>
      <p class="eyebrow mt-6">{d.client}</p>
      <h1 class="mt-3 text-display font-extrabold tracking-tightest">{d.title}</h1>
      <p class="mt-6 text-xl text-paper/85 leading-relaxed max-w-3xl">{d.outcome}</p>
    </header>

    <figure class="mt-12 relative aspect-[16/9] border border-edge overflow-hidden bg-[radial-gradient(circle_at_35%_35%,rgba(255,255,255,0.04),transparent_60%)]">
      <img
        src={d.hero}
        alt={`${d.client} — ${d.title}`}
        class="absolute inset-0 w-full h-full object-cover"
        onerror="this.style.display='none'"
      />
    </figure>

    <div class="mt-16 grid lg:grid-cols-12 gap-10 lg:gap-14">
      <div class="lg:col-span-8 case-body">
        <Content components={mdxComponents} />
      </div>

      {specRows.length > 0 && (
        <aside class="lg:col-span-4">
          <div class="lg:sticky lg:top-28 border border-edge bg-ink/40 p-6 md:p-7">
            <p class="eyebrow">Spec sheet</p>
            <dl class="mt-6 space-y-5">
              {specRows.map((row) => (
                <div>
                  <dt class="font-spec text-mute text-xs uppercase tracking-widest">{row.label}</dt>
                  <dd class="mt-2 font-spec text-paper text-sm">
                    {Array.isArray(row.value) ? (
                      <ul class="space-y-1.5">
                        {row.value.map((v) => (
                          <li class="leading-tight relative pl-4 before:absolute before:left-0 before:top-0 before:content-['·'] before:text-sun">{v}</li>
                        ))}
                      </ul>
                    ) : (
                      <span>{row.value}</span>
                    )}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        </aside>
      )}
    </div>

    {galleryFiltered.length > 0 && (
      <div class="mt-20">
        <p class="eyebrow mb-6">Gallery</p>
        <div class="grid sm:grid-cols-2 gap-4 md:gap-5">
          {galleryFiltered.map((src) => (
            <figure class="relative aspect-[4/3] border border-edge overflow-hidden bg-[radial-gradient(circle_at_35%_35%,rgba(255,255,255,0.04),transparent_60%)]">
              <img src={src} alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
            </figure>
          ))}
        </div>
      </div>
    )}

    <aside class="mt-20 border border-edge bg-ink/40 p-8 md:p-12">
      <p class="eyebrow">Something similar</p>
      <h2 class="mt-3 text-h2 font-extrabold tracking-tightest max-w-2xl">
        Want one of these?
      </h2>
      <p class="mt-3 text-paper/85 max-w-xl">
        Hit Sulaiman on WhatsApp — he'll have a sense of scope and timing in the
        first reply.
      </p>
      <div class="mt-7">
        <WhatsAppButton
          target="projects"
          message={prefills.caseStudy(d.title)}
          label={`Discuss something like ${d.title}`}
        />
      </div>
    </aside>

    <div class="my-section"></div>
  </article>
</BaseLayout>

<style is:global>
  /* Case study body styling — workshop-spec feel, not editorial prose.
     Targets descendant tags inside .case-body, applied via global scope so it
     reaches MDX-rendered content. */
  .case-body h2 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 800;
    color: var(--paper);
    margin-top: 3rem;
    margin-bottom: 1.25rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--edge);
  }
  .case-body > h2:first-child,
  .case-body > :is(p, ul) + h2:first-of-type {
    /* The first h2 we see still wants a top divider — only the very first
       child element of the body should sit flush. */
  }
  .case-body > :first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .case-body h3 {
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    font-weight: 700;
    color: var(--paper);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .case-body p {
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.65;
    margin-top: 1rem;
    margin-bottom: 1rem;
    max-width: 64ch;
  }
  .case-body strong {
    color: var(--paper);
    font-weight: 600;
  }
  .case-body em {
    color: var(--paper);
    font-style: italic;
  }
  .case-body ul {
    list-style: none;
    padding-left: 0;
    margin: 1rem 0;
    max-width: 64ch;
  }
  .case-body ul li {
    position: relative;
    padding-left: 1.25rem;
    margin: 0.4rem 0;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.55;
  }
  .case-body ul li::before {
    content: "·";
    color: var(--sun);
    position: absolute;
    left: 0;
    top: -0.05em;
    font-weight: 700;
  }
  .case-body a {
    color: var(--paper);
    text-decoration: underline;
    text-decoration-color: var(--sun);
    text-underline-offset: 0.2em;
    text-decoration-thickness: 2px;
  }
  .case-body a:hover {
    color: var(--sun);
  }
  .case-body hr {
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid var(--edge);
  }
</style>
