---
import WhatsAppButton from "~/components/WhatsAppButton.astro";
import { prefills } from "~/lib/whatsapp";

const caps = [
  { name: "CO2 laser", spec: "Acrylic · MDF · paper · fabric", icon: "laser" },
  { name: "Fiber laser", spec: "Stainless · aluminium · brass", icon: "fiber" },
  { name: "UV flatbed", spec: "Direct to rigid · 4×8 ft bed", icon: "uv" },
  { name: "ECO solvent", spec: "Large format · vinyl · banner", icon: "ecosol" },
  { name: "DTF", spec: "Textile transfers · soft goods", icon: "dtf" },
  { name: "3D printing", spec: "FDM · SLA · resin finishing", icon: "fdm" },
  { name: "CAD/CAM", spec: "Files in · production-ready", icon: "cad" },
  { name: "Assembly + install", spec: "Crew on site · UAE + ZA", icon: "asm" },
];
---

<section
  id="capabilities"
  class="section bg-ink"
  aria-labelledby="capabilities-heading"
>
  <div class="wrap">
    <header class="mb-12">
      <p class="eyebrow">Make a part</p>
      <h2 id="capabilities-heading" class="mt-3 text-h1 font-extrabold tracking-tightest max-w-3xl">
        Eight machines. <span class="hl">Send the file.</span>
      </h2>
      <p class="mt-4 max-w-2xl text-paper/85 leading-relaxed">
        Each tile quotes directly. Click through and you're on WhatsApp with Pranav,
        already pre-filled with what you need.
      </p>
    </header>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
      {caps.map((c) => (
        <article class="group relative flex flex-col border border-edge bg-ink/40 p-5 md:p-6 transition-all duration-300 ease-punch hover:border-paper">
          <!-- Mini-demo slot — Phase 2 layers in lightweight CSS/SVG looping animations here -->
          <div class="aspect-[5/3] rounded-sm border border-edge bg-[radial-gradient(circle_at_30%_30%,rgba(255,218,0,0.05),transparent_60%)] mb-5 grid place-items-center text-mute font-spec text-xs">
            <span data-capability-demo={c.icon}>· demo coming Phase 2 ·</span>
          </div>

          <h3 class="text-h3 font-bold tracking-tightest">{c.name}</h3>
          <p class="mt-1 font-spec text-mute text-sm">{c.spec}</p>

          <div class="mt-5 pt-4 border-t border-edge">
            <WhatsAppButton
              target="quotes"
              message={prefills.capabilityQuote(c.name)}
              label="Quote on WhatsApp"
              variant="ghost"
              class="w-full justify-center text-sm py-3"
            />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
