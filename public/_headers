# Cloudflare Workers Static Assets custom headers.
# Without this, every asset ships `max-age=0, must-revalidate` and browsers
# re-check each file on every visit. Hashed/immutable assets get a year;
# media gets 30 days (videos/posters do occasionally get re-exported under
# the same name). HTML keeps the default revalidate behaviour.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=2592000

/videos/*
  Cache-Control: public, max-age=2592000

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/reel-720p.mp4
  Cache-Control: public, max-age=2592000

/favicon.svg
  Cache-Control: public, max-age=604800
