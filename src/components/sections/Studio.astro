---
import { site } from "~/lib/site";
---

<section id="studio" class="section" aria-labelledby="studio-heading">
  <div class="wrap grid lg:grid-cols-[1fr_1fr] gap-12">
    <div>
      <p class="eyebrow">The Studio</p>
      <h2 id="studio-heading" class="mt-3 text-h1 font-extrabold tracking-tightest">
        Two cities. <span class="hl">One team.</span>
      </h2>
      <p class="mt-5 text-paper/85 leading-relaxed max-w-xl">
        NSQD operates from a fabrication warehouse in Jebel Ali, Dubai, and a studio
        in Wynberg, Cape Town. The same people on the same brief. Design from one
        side, production from the other, install wherever it lands.
      </p>
      <p class="mt-4 text-paper/85 leading-relaxed max-w-xl">
        Lean team. No subcontractor chain hiding behind a brand. The person you
        message is the person on the floor.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      {site.offices.map((office) => (
        <article class="border border-edge bg-ink/40 p-6">
          <div class="eyebrow">{office.country}</div>
          <h3 class="mt-3 text-h3 font-bold tracking-tightest">{office.city}</h3>
          <p class="mt-1 font-spec text-mute text-sm">{office.area}</p>
          <p class="mt-4 text-paper/85 text-sm leading-relaxed">{office.address}</p>
        </article>
      ))}
    </div>
  </div>

  <div class="wrap mt-12 pt-8 border-t border-edge">
    <p class="font-spec text-mute text-sm">Producing from somewhere specific?</p>
    <div class="mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <a
        href="/saudi-arabia/"
        class="group flex items-center justify-between gap-4 border border-edge bg-ink/40 p-5 transition-all duration-300 ease-punch hover:border-paper"
      >
        <span>
          <span class="font-bold tracking-tightest">Saudi Arabia</span>
          <span class="block font-spec text-mute text-sm mt-0.5">Built in Dubai, delivered in-Kingdom</span>
        </span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-sun transition-transform duration-200 group-hover:translate-x-1"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a
        href="/south-africa/"
        class="group flex items-center justify-between gap-4 border border-edge bg-ink/40 p-5 transition-all duration-300 ease-punch hover:border-paper"
      >
        <span>
          <span class="font-bold tracking-tightest">South Africa</span>
          <span class="block font-spec text-mute text-sm mt-0.5">Cape Town studio, nationwide install</span>
        </span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-sun transition-transform duration-200 group-hover:translate-x-1"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a
        href="/uk/"
        class="group flex items-center justify-between gap-4 border border-edge bg-ink/40 p-5 transition-all duration-300 ease-punch hover:border-paper"
      >
        <span>
          <span class="font-bold tracking-tightest">UK &amp; EU agencies</span>
          <span class="block font-spec text-mute text-sm mt-0.5">Producing in the GCC, built locally</span>
        </span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-sun transition-transform duration-200 group-hover:translate-x-1"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</section>
